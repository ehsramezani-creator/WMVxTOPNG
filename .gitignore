# ------------------------------------------------------------
*.backup
*.bak
*.old
*.tmp
*~
*- Copy.*
*-copy.*

# Explicit temporary copies/backups
src/tools/render-model - Copy.js
src/tools/render-model.js.backup

# ------------------------------------------------------------
